# Copy to .env and change every value marked CHANGE_ME
POSTGRES_DB=localgrc
POSTGRES_USER=localgrc
POSTGRES_PASSWORD=CHANGE_ME
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_django-admin_startproject
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
HTTP_PORT=8080

# First-run bootstrap (idempotent — safe to keep, used only if no users exist yet)
LOCALGRC_ADMIN_EMAIL=admin@local
LOCALGRC_ADMIN_PASSWORD=CHANGE_ME
LOCALGRC_ADMIN_ORG_NAME=Default Organization